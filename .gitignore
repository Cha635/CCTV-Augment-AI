# YOLO Model Checkpoints (Keep fine-tuned experiment best weights, ignore intermediate weights)
models/trained/**/last.pt
models/trained/**/epoch*.pt
models/pretrained/yolov8*.pt
!models/trained/cctv_exp_original/weights/best.pt
!models/trained/cctv_exp_augmented/weights/best.pt

# Large dataset image files and archives (prevent bloating git repository)
# Keep the split definitions, YAML configs, and directory structure (.gitkeep)
dataset/splits/images/
dataset/augmented/images/
dataset/original/
dataset/processed/
yolo-person-vehicle-dataset/
*.zip
*.tar
*.gz
*.rar

# Output generation directories (allow directories via .gitkeep, ignore generated runs)
outputs/augmented_images/*
outputs/batches/*
outputs/comparisons/*
outputs/detections/*
output/
!outputs/.gitkeep
!outputs/reports/

# Temporary and runtime logs (allow directory via .gitkeep)
logs/*.log
logs/*_status.json
!logs/.gitkeep
